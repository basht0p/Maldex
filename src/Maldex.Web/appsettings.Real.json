{
  // Layered over appsettings.json when Maldex:Mode is Real (MALDEX_MODE=Real ./build.sh run, or Maldex__Mode=Real).
  // Environment variables and command-line settings still override everything here. (JSON comments are allowed in .NET config.)
  "Maldex": {
    "Mode": "Real",
    "Images": [ "win11-26h2" ],
    // 32 MiB = AgentLimits.MaxInboundBytes, the most the guest agent accepts; submissions above it get a 413 (never a VM boot).
    "MaxUploadBytes": 33554432,
    "Real": {
      // ONE base for every relative path below (and for RunDir). Empty = the directory that contains Maldex.slnx, found by
      // walking up from the binaries; startup fails with a clear message if there is none. Set it for an installed layout.
      "Root": "",
      // ONE RunDir for the hypervisor, the agent channel and the network layer (the agent socket {RunDir}/{vm}/agent.sock
      // must agree). It overrides Libvirt:RunDir, Agent:RunDir and Net:RunDir.
      "RunDir": ".data/vm/run",
      "Libvirt": {
        "Uri": "qemu:///session",
        "BaseImageDir": ".data/vm/base",
        "OvmfCodePath": "/usr/share/OVMF/OVMF_CODE_4M.secboot.fd",
        "MachineType": "q35"
      },
      "Agent": { "ConnectTimeout": "00:00:30" },
      "Net": {
        // Extra addresses guests must never reach. The host's own non-loopback IPv4 addresses (docker bridges included)
        // are always added automatically; startup fails if the union is empty.
        "ControlPlaneIps": [],
        "SubnetBase": "10.213.0.0/16",
        "SinkholeIp": "198.18.0.10",
        "MitmConfDir": ".data/mitm/ca",
        "DeployNetDir": "deploy/net",
        "InetSimDataDir": "/var/lib/inetsim",
        "WireGuardConfigDir": "/etc/maldex/wg"
      },
      "Suricata": {
        "Binary": "suricata",
        "ConfigPath": "deploy/net/suricata/suricata.yaml",
        "RulesPath": "deploy/net/suricata/maldex-dev.rules"
      },
      "SelfTest": { "RequireControlPlaneProbes": true }
    }
  }
}
