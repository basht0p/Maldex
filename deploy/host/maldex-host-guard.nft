#!/usr/sbin/nft -f
# Maldex host guard: the host never routes for, or accepts traffic from, per-run mx* interfaces,
# and run bridges carry only IPv4 and ARP frames.
table inet maldex_guard
delete table inet maldex_guard
table inet maldex_guard {
	chain forward {
		type filter hook forward priority -10; policy accept;
		# Direct egress (template edit sessions): the per-lease table inet maldex_direct_<id> decides what mxu* uplinks may
		# forward (only to the default-route interface); everything else on mx* stays dropped.
		iifname "mxu*" oifname != "mx*" accept
		oifname "mxu*" iifname != "mx*" ct state established,related accept
		iifname "mx*" drop
		oifname "mx*" drop
	}
	chain input {
		type filter hook input priority -10; policy accept;
		iifname "mx*" drop
	}
}
table bridge maldex_guard
delete table bridge maldex_guard
table bridge maldex_guard {
	chain forward {
		type filter hook forward priority -10; policy accept;
		ibrname "mxb*" ether type != { ip, arp } drop
	}
	chain input {
		type filter hook input priority -10; policy accept;
		ibrname "mxb*" drop
	}
}
