{
  // Maldex host configuration: /etc/maldex/appsettings.Production.json (root:maldex 0640, kept on upgrade).
  // It is loaded last, after /opt/maldex/app/appsettings.Package.json (MALDEX_EXTRA_CONFIG in maldex.service), so anything set
  // here wins. Comments are allowed. After editing: sudo maldex-setup (first time), or sudo systemctl restart maldex.
  //
  // The package expects Maldex:Mode to stay Real (the packaged defaults set it); do not set Mode here.

  // Required: the external SQL Server database, for example
  // Server=sqlhost,1433;Database=maldex;User Id=maldex;Password=...;TrustServerCertificate=True
  "ConnectionStrings": {
    "Maldex": ""
  },

  "Maldex": {
    // Sign-in. Local accounts work out of the box: maldex-setup creates the first admin, and sudo maldex-admin manages the rest.
    // Optional single sign-on through any OpenID Connect provider (the README's "Single sign-on" section has Entra ID and
    // Keycloak examples). Register <public origin>/signin-oidc as the redirect URI at the provider. ClientSecret lives in this
    // file, so keep it root:maldex 0640.
    //   PasswordLogin=false switches password sign-in off for everyone except break-glass local admins (needs Oidc.Enabled=true).
    //   RoleClaim empty: SSO users start with no access and an admin assigns their role in Maldex. RoleClaim set: the provider
    //   decides at every sign-in; a value in AdminValues gives Admin, else a value in AnalystValues gives Analyst, else the
    //   sign-in is refused. Values are matched exactly (case-sensitive, trimmed).
    // Restart after editing: sudo systemctl restart maldex
    "Auth": {
      "PasswordLogin": true,
      "Oidc": {
        "Enabled": false,
        "DisplayName": "Company SSO",
        "Authority": "",
        "ClientId": "",
        "ClientSecret": "",
        "Scopes": ["openid", "profile", "email"],
        "NameClaim": "name",
        "RoleClaim": "",
        "AdminValues": [],
        "AnalystValues": []
      }
    },
    "Real": {
      // Maldex:Real:Root, the data directory (VM images, media, artifacts). The package creates it, owned by maldex, 0750.
      "Root": "/var/lib/maldex",
      // UEFI firmware for the guests: this distro's OVMF Secure Boot code and the variable store with Microsoft keys enrolled.
      "Libvirt": {
        "OvmfCodePath": "/usr/share/OVMF/OVMF_CODE_4M.secboot.fd",
        "OvmfVarsTemplatePath": "/usr/share/OVMF/OVMF_VARS_4M.ms.fd"
      }
    }
  }
}
