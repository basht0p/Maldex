# Maldex deployment settings.
# `deploy/maldexctl install` copies this to deploy/.env and fills in the secrets.
# To do it by hand: cp .env.example .env && chmod 600 .env, then fill the blanks.
# deploy/.env holds secrets and is git-ignored. Never commit it.
#
# Passwords: 16+ characters with upper, lower and digits (SQL Server policy).
# Avoid ' ; and " in passwords, since they end up in connection strings and SQL.

# --- Stack shape --------------------------------------------------------------
# bundled-db  run SQL Server in this stack (remove it to use an existing server)
COMPOSE_PROFILES=bundled-db

# Image tag for locally built images. Bump when you build a new release.
MALDEX_VERSION=local

# --- App endpoint -----------------------------------------------------------------
# Plain HTTP. Keep it on 127.0.0.1 and put your reverse proxy / TLS in front;
# only bind wider if a trusted proxy on another host needs it.
MALDEX_HTTP_BIND=127.0.0.1
MALDEX_HTTP_PORT=8080

# --- Database -------------------------------------------------------------------
# With bundled-db, leave HOST=sql. For an existing server, set its host/port and
# an admin login that can CREATE DATABASE and CREATE LOGIN (used by db-init/migrate only).
MALDEX_DB_HOST=sql
MALDEX_DB_PORT=1433
MALDEX_DB_NAME=maldex
MALDEX_DB_ADMIN_USER=sa
MALDEX_DB_ADMIN_PASSWORD=
# Runtime login the web app uses: data read/write only, no schema changes.
MALDEX_DB_APP_USER=maldex_app
MALDEX_DB_APP_PASSWORD=
# True accepts the server's self-signed cert (fine for bundled-db). Set False when
# your external SQL Server has a certificate this host trusts.
MALDEX_DB_TRUST_SERVER_CERT=True

# --- Bundled SQL Server (bundled-db profile only) ---------------------------------
# You must accept the SQL Server EULA: https://go.microsoft.com/fwlink/?linkid=857698
MSSQL_ACCEPT_EULA=
# Edition. Express is free for production (10 GB per DB). Developer is NOT licensed
# for production. Standard/Enterprise need your own license.
MSSQL_PID=Express
MSSQL_MEMORY_LIMIT_MB=2048
MSSQL_VERSION=2022-latest

# --- App ------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
