{
  // Packaged-install defaults, loaded through MALDEX_EXTRA_CONFIG after appsettings.json / appsettings.Real.json and before
  // /etc/maldex/appsettings.Production.json. Bundled, read-only assets are absolute /opt/maldex paths; data paths stay relative
  // and resolve under Maldex:Real:Root.
  "Maldex": {
    "Real": {
      "Root": "/var/lib/maldex",
      "Net": { "DeployNetDir": "/opt/maldex/deploy/net" },
      "Suricata": {
        "ConfigPath": "/opt/maldex/deploy/net/suricata/suricata.yaml",
        "RulesPath": "/opt/maldex/deploy/net/suricata/maldex-dev.rules"
      }
    },
    "Templates": {
      "Jobs": {
        "AgentExePath": "/opt/maldex/agent/Maldex.Agent.exe",
        "AgentVersionPath": "/opt/maldex/agent/Maldex.Agent.version",
        "SysmonConfigPath": "/opt/maldex/deploy/guest/provision/sysmon-config.xml"
      },
      "Build": {
        "AutounattendPath": "/opt/maldex/deploy/guest/autounattend/Autounattend.xml",
        "ProvisionScriptPath": "/opt/maldex/deploy/guest/provision/Provision.ps1",
        "OfficeConfigPath": "/opt/maldex/deploy/guest/provision/office-config.xml",
        "JobLogDir": "/var/log/maldex/jobs"
      }
    },
    "Yara": { "RulesIndex": "/opt/maldex/rules/yara/index.yar" }
  }
}
