#!/usr/bin/env bash
# maldex-setup: the host setup a packaged Maldex install needs after the package is installed (spec §5). Run it as root; it is
# safe to re-run, and each run starts from the first step and skips what is already done.
#
#   maldex-setup                    run every step, stop at the first failure
#   maldex-setup --offline <dir>    take Sysmon.zip and virtio-win.iso from <dir> instead of downloading them (same hash checks),
#                                   and Chromium from <dir>/ms-playwright if present (else warn: PDF reports need it)
#   maldex-setup --check            run only the read-only checks, print every result, change nothing (root not required);
#                                   its guest disk editor check boots a throwaway libguestfs appliance (libguestfs-test-tool)
#
# The admin step (after db) creates the first Maldex admin with maldex-admin when none is enabled: on a terminal it asks for the
# user name and maldex-admin asks for the password; without one it fails and prints the command to run.
#
# Each step prints "ok   <step>" or "FAIL <step> -- <hint>". Paths can be moved for tests: MALDEX_ETC (default /etc/maldex),
# MALDEX_DATA (default /var/lib/maldex, Maldex:Real:Root) and MALDEX_OPT (default /opt/maldex).
set -uo pipefail

HELP="usage: maldex-setup [--check] [--offline <dir>]
  (no flag)        run every step as root; stop at the first failure; safe to re-run
  --offline <dir>  take Sysmon.zip and virtio-win.iso from <dir> (same SHA-256 checks), and the
                   Playwright Chromium from <dir>/ms-playwright if present (else warn; only PDF reports need it)
  --check          read-only checks only, as any user; prints every result and changes nothing.
                   The guest disk editor check boots a throwaway libguestfs appliance (libguestfs-test-tool,
                   about 30 s, needs KVM); it writes only libguestfs's own temp files."
usage() { echo "$HELP" >&2; exit 64; }

CHECK=0
OFFLINE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --check) CHECK=1; shift ;;
    --offline) if [ $# -lt 2 ] || [ -z "$2" ]; then usage; fi; OFFLINE="$2"; shift 2 ;;
    -h|--help) echo "$HELP"; exit 0 ;;
    *) usage ;;
  esac
done

if [ "$(id -u)" = 0 ]; then
  MALDEX_SUDO=""
elif [ "$CHECK" = 1 ]; then
  MALDEX_SUDO="sudo -n"   # read-only checks that need root then fail instead of prompting
else
  echo "maldex-setup must run as root (sudo maldex-setup); 'maldex-setup --check' runs the read-only checks as any user" >&2
  exit 1
fi

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=SCRIPTDIR/../lib/maldex-common.sh
source "$HERE/../lib/maldex-common.sh" || { echo "maldex-setup: cannot load $HERE/../lib/maldex-common.sh" >&2; exit 1; }

MALDEX_ETC="${MALDEX_ETC:-/etc/maldex}"
MALDEX_DATA="${MALDEX_DATA:-/var/lib/maldex}"
MALDEX_OPT="${MALDEX_OPT:-/opt/maldex}"
CONFIG="$MALDEX_ETC/appsettings.Production.json"
APP_USER="maldex"
ISO_DIR="$MALDEX_DATA/.data/vm/iso"
MITM_CA="$MALDEX_DATA/.data/mitm/ca"
AGENT_SRC="$MALDEX_OPT/agent"   # the app reads the agent bundle from the package (controller ruling T2-1)
MEDIA_DIR="$MALDEX_DATA/.data/media"
GUESTFS_DIR="$MALDEX_DATA/guestfs-appliance"
BROWSERS_DIR="$MALDEX_DATA/ms-playwright"
APP_URL="http://127.0.0.1:5080"
# Host paths the verify checks read; overridable so the tests do not depend on the host.
read -r -a OVMF_SECBOOT_CANDIDATES <<<"${MALDEX_OVMF_SECBOOT:-/usr/share/OVMF/OVMF_CODE_4M.secboot.fd /usr/share/edk2/ovmf/OVMF_CODE.secboot.fd}"
BR_NF_CALL_IPTABLES="${MALDEX_BR_NF_CALL_IPTABLES:-/proc/sys/net/bridge/bridge-nf-call-iptables}"
KVM_DEV="${MALDEX_KVM_DEV:-/dev/kvm}"
# The emulator the domain XML names (DomainXmlBuilder); on RHEL the rpm links it to /usr/libexec/qemu-kvm.
QEMU_EMULATOR="${MALDEX_QEMU_EMULATOR:-/usr/bin/qemu-system-x86_64}"
START_WAIT="${MALDEX_START_WAIT:-5}"   # seconds the service must stay active after the restart
SYSTEM_USERS=(maldex-mitm maldex-dns maldex-isroot maldex-isuser)

HINT=""   # set by a failing step or check
fail() { HINT="$*"; return 1; }

# ---- db ----

# The string value of ConnectionStrings:Maldex in JSON file $1 (empty when missing). python3 parses it as JSON (full-line //
# comments stripped, keys matched case-insensitively, as .NET configuration does); without python3, or when that parse fails,
# a sed parse runs instead: the value runs to the first unescaped quote, and a "}" anywhere in the ConnectionStrings object (for
# example in the password) defeats it.
connection_string() {
  local cs
  # shellcheck disable=SC2016  # a python program, not shell
  if command -v python3 >/dev/null 2>&1 && cs="$(python3 -I -c '
import json, re, sys
d = json.loads(re.sub(r"(?m)^\s*//.*$", "", open(sys.argv[1], encoding="utf-8-sig").read()))
def get(o, k):
    return next((v for kk, v in o.items() if kk.lower() == k.lower()), None) if isinstance(o, dict) else None
v = get(get(d, "ConnectionStrings"), "Maldex")
print(v if isinstance(v, str) else "")
' "$1" 2>/dev/null)"; then
    printf '%s\n' "$cs"
    return
  fi
  tr '\n\r\t' '   ' < "$1" \
    | sed -nE 's/.*"ConnectionStrings"[[:space:]]*:[[:space:]]*\{([^}]*)\}.*/\1/p' \
    | sed -nE 's/.*"Maldex"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)".*/\1/p'
}

# Prints "host port" from the Server (or Data Source / Address) part of connection string $1; the port defaults to 1433.
sql_endpoint() {
  local part key value server="" host port
  local IFS=';'
  for part in $1; do
    key="${part%%=*}"; value="${part#*=}"
    [ "$key" != "$part" ] || continue
    key="$(echo "$key" | tr '[:upper:]' '[:lower:]' | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')"
    case "$key" in server|"data source"|address|addr|"network address") server="$value" ;; esac
  done
  server="$(echo "$server" | sed -E 's/^[[:space:]]+|[[:space:]]+$//g; s/^tcp://I')"
  [ -n "$server" ] || return 1
  host="${server%%,*}"; port="1433"
  [ "$host" = "$server" ] || port="${server#*,}"
  host="${host%%\\*}"   # a named instance (host\instance) is reached on the given or default port
  port="$(echo "$port" | tr -d '[:space:]')"
  case "$host" in .|"(local)"|"(localdb)") host="localhost" ;; esac
  [[ "$host" =~ ^[A-Za-z0-9._-]+$ ]] && [[ "$port" =~ ^[0-9]+$ ]] || return 1
  echo "$host $port"
}

db_check() {
  local how="set ConnectionStrings:Maldex in $CONFIG, e.g. \"ConnectionStrings\": { \"Maldex\": \"Server=sqlhost,1433;Database=maldex;User Id=maldex;Password=...;TrustServerCertificate=True\" }"
  [ -f "$CONFIG" ] || fail "$CONFIG is missing; $how" || return 1
  [ -r "$CONFIG" ] || fail "$CONFIG is not readable; $how" || return 1
  local cs ep host port
  cs="$(connection_string "$CONFIG")"
  [ -n "$cs" ] || fail "ConnectionStrings:Maldex is not set in $CONFIG (maldex-setup reads only that file, not a ConnectionStrings__Maldex variable set in a systemd drop-in); $how" || return 1
  ep="$(sql_endpoint "$cs")" || fail "ConnectionStrings:Maldex has no usable Server=host[,port]; $how" || return 1
  host="${ep% *}"; port="${ep#* }"
  # shellcheck disable=SC2016  # $1/$2 belong to the inner bash
  timeout 5 bash -c '</dev/tcp/$1/$2' _ "$host" "$port" >/dev/null 2>&1 \
    || fail "cannot reach SQL Server at $host:$port (from ConnectionStrings:Maldex in $CONFIG); check the server, the firewall and the host name" \
    || return 1
}

# ---- admin ----

ADMIN_CMD="$HERE/maldex-admin"   # /opt/maldex/bin/maldex-admin (it must run as root: $MALDEX_SUDO is "sudo -n" for --check)
CREATE_HINT="no Maldex admin exists; create one with: sudo maldex-admin create-user <name> --admin"

# Reads `maldex-admin list --json` (one JSON array line, then "#config {...}") and sets ADMIN_ENABLED (enabled Admins, SSO
# included), ADMIN_BREAKGLASS (enabled break-glass local Admins), ADMIN_PASSWORD_LOGIN and ADMIN_SSO (true|false). Fails with
# HINT set when maldex-admin or the parse fails (exit 78 from maldex-admin: configuration or database error).
admin_state() {
  local out rc state errf
  errf="$(mktemp)" || { fail "cannot create a temporary file"; return 1; }
  # stdout is the JSON stream; stderr (messages, warnings) is kept apart and shown only on failure
  # shellcheck disable=SC2086  # MALDEX_SUDO is empty or "sudo -n"
  out="$($MALDEX_SUDO "$ADMIN_CMD" list --json 2>"$errf")"; rc=$?
  if [ "$rc" != 0 ]; then
    fail "maldex-admin list failed (exit status $rc; 78 is a configuration or database error, so check ConnectionStrings:Maldex and Maldex:Auth in $CONFIG): $(tail -n 3 "$errf" | tr '\n' ' ')"
    rm -f "$errf"
    return 1
  fi
  rm -f "$errf"
  command -v python3 >/dev/null 2>&1 || { fail "python3 is needed to read the maldex-admin output"; return 1; }
  # shellcheck disable=SC2016  # a python program, not shell
  state="$(printf '%s\n' "$out" | python3 -I -c '
import json, sys
users, cfg = [], {}
for line in sys.stdin:
    line = line.strip()
    if line.startswith("#config "):
        cfg = json.loads(line[8:])
    elif line.startswith("["):
        users = json.loads(line)
adm = [u for u in users if u.get("role") == "Admin" and not u.get("isDisabled")]
bg = [u for u in adm if u.get("kind") == "Local" and u.get("isBreakGlass")]
print(len(adm), len(bg), str(cfg.get("passwordLogin", True)).lower(), str(cfg.get("ssoEnabled", False)).lower())
' 2>/dev/null)" || { fail "cannot parse the maldex-admin list output"; return 1; }
  read -r ADMIN_ENABLED ADMIN_BREAKGLASS ADMIN_PASSWORD_LOGIN ADMIN_SSO <<<"$state"
  [ -n "$ADMIN_SSO" ] || { fail "cannot parse the maldex-admin list output"; return 1; }
}

# Creates the first admin when none is enabled. Interactive only ([ -t 0 ]; MALDEX_ASSUME_TTY=1 is the test stand-in): the user
# name is asked here, and maldex-admin prompts for the password itself, without echo.
step_admin() {
  admin_state || return 1
  [ "$ADMIN_ENABLED" = 0 ] || return 0
  if [ ! -t 0 ] && [ "${MALDEX_ASSUME_TTY:-0}" != 1 ]; then
    fail "$CREATE_HINT" || return 1
  fi
  local name args=(--admin)
  printf 'First admin user name [admin]: ' >&2
  IFS= read -r name || name=""
  [ -t 0 ] || echo >&2   # on a terminal the Enter key ends the prompt line; piped input does not
  name="${name:-admin}"
  [[ "$name" =~ ^[A-Za-z0-9._@][A-Za-z0-9._@-]{0,63}$ ]] \
    || fail "invalid user name '$name' (1-64 characters of A-Z a-z 0-9 . _ @ -, not starting with -); $CREATE_HINT" || return 1
  # With password login off, the first admin is the break-glass account that keeps Maldex reachable.
  [ "$ADMIN_PASSWORD_LOGIN" = true ] || args+=(--break-glass)
  "$ADMIN_CMD" create-user "$name" "${args[@]}" \
    || fail "maldex-admin create-user $name failed; fix the cause above, or run it yourself: sudo maldex-admin create-user $name ${args[*]}" || return 1
}

# --check: fails without an enabled Admin; warns (does not fail) when password login is off, SSO is on and no break-glass admin
# exists (an IdP outage would then lock everyone out).
admin_check() {
  admin_state || return 1
  [ "$ADMIN_ENABLED" != 0 ] || fail "$CREATE_HINT" || return 1
  if [ "$ADMIN_PASSWORD_LOGIN" = false ] && [ "$ADMIN_SSO" = true ] && [ "$ADMIN_BREAKGLASS" = 0 ]; then
    echo "warn admin -- password login is off and no break-glass admin exists, so an SSO outage locks everyone out; run: sudo maldex-admin set-break-glass <local admin> on" >&2
  fi
}

# ---- downloads ----

# Set owner $1 and mode $2 on $3, refusing a symlink (root must not be steered to chown/chmod another path).
own_mode() {
  local owner="$1" mode="$2" p="$3"
  [ ! -L "$p" ] || { echo "refusing to change $p: it is a symlink" >&2; return 1; }
  chown -h "$owner" "$p" || return 1
  chmod "$mode" "$p"
}

# Directory $1 owned by the app user, mode 0750; it must not be a symlink.
app_dir() {
  local d="$1"
  [ ! -L "$d" ] || { echo "refusing to use $d: it is a symlink" >&2; return 1; }
  mkdir -p "$d" || return 1
  own_mode "$APP_USER:$APP_USER" 0750 "$d"
}

data_layout() {
  local d
  for d in "$MALDEX_DATA" "$MALDEX_DATA/.data" "$MALDEX_DATA/.data/vm" "$MALDEX_DATA/.data/vm/base" "$MALDEX_DATA/.data/vm/run" \
           "$ISO_DIR" "$MEDIA_DIR" "$MALDEX_DATA/.data/artifacts" "$MALDEX_DATA/.data/mitm"; do
    app_dir "$d" || return 1
  done
  # SELinux (RHEL): label the VM tree with the virt_image_t rule the package's %post registered.
  if command -v selinuxenabled >/dev/null 2>&1 && selinuxenabled; then restorecon -R "$MALDEX_DATA/.data/vm" || return 1; fi
}

# File $1 of the pinned set into $ISO_DIR: kept when it already verifies, else copied from --offline or downloaded, then verified.
fetch_pinned() {
  local name="$1" url="$2" sha="$3" dest="$ISO_DIR/$1"
  if [ -L "$dest" ] || [ -L "$dest.part" ]; then echo "refusing to use $dest: it is a symlink" >&2; return 1; fi
  if [ -s "$dest" ] && echo "$sha  $dest" | sha256sum -c --status - 2>/dev/null; then
    own_mode "$APP_USER:$APP_USER" 0640 "$dest"
    return
  fi
  rm -f "$dest" "$dest.part"
  if [ -n "$OFFLINE" ]; then
    [ -f "$OFFLINE/$name" ] || { echo "$OFFLINE/$name is missing" >&2; return 1; }
    cp "$OFFLINE/$name" "$dest.part" || return 1
    verify_sha256 "$dest.part" "$sha" || return 1
    mv "$dest.part" "$dest" || return 1
  else
    fetch_cached "$url" "$dest" "$sha" || return 1
  fi
  own_mode "$APP_USER:$APP_USER" 0640 "$dest"
}

step_downloads() {
  local src="download (needs https access to download.sysinternals.com and fedorapeople.org), or supply the files with --offline <dir>"
  [ -n "$OFFLINE" ] && src="put Sysmon.zip and virtio-win.iso with the pinned SHA-256 values in $OFFLINE"
  [ -z "$OFFLINE" ] || [ -d "$OFFLINE" ] || fail "--offline: $OFFLINE is not a directory" || return 1
  data_layout || fail "cannot create the data layout under $MALDEX_DATA" || return 1
  fetch_pinned Sysmon.zip "$SYSMON_URL" "$SYSMON_SHA256" || fail "Sysmon.zip: $src" || return 1
  fetch_pinned virtio-win.iso "$VIRTIO_WIN_URL" "$VIRTIO_WIN_SHA256" || fail "virtio-win.iso: $src" || return 1
}

# ---- mitm-ca, inetsim, guestfs ----

step_mitm_ca() {
  local u
  for u in "${SYSTEM_USERS[@]}"; do
    ensure_system_user "$u" || fail "cannot create the system user $u (useradd)" || return 1
  done
  ensure_mitm_ca "$MITM_CA" maldex-mitm || fail "mitmproxy CA not created in $MITM_CA; check that mitmdump runs (mitmdump --version)" || return 1
  # The app reads the cert (template sealing) and checks the key exists; it copies them per run as root.
  # The private key files stay 0600 maldex-mitm.
  local f
  own_mode "maldex-mitm:$APP_USER" 0750 "$MITM_CA" || fail "cannot set the owner and mode of $MITM_CA" || return 1
  own_mode "maldex-mitm:$APP_USER" 0640 "$MITM_CA/mitmproxy-ca-cert.pem" || fail "cannot set the mode of the CA cert" || return 1
  for f in mitmproxy-ca.pem mitmproxy-ca.p12; do
    [ -e "$MITM_CA/$f" ] || [ -L "$MITM_CA/$f" ] || continue
    own_mode maldex-mitm:maldex-mitm 0600 "$MITM_CA/$f" || fail "cannot set the mode of $MITM_CA/$f" || return 1
  done
}

INETSIM_HINT="install INetSim (Ubuntu: the inetsim package; RHEL: no package exists, install it by hand as the README describes)"

step_inetsim() {
  [ -d "$INETSIM_TEMPLATE_DIR" ] || fail "$INETSIM_TEMPLATE_DIR is missing; $INETSIM_HINT" || return 1
  harden_inetsim_template || fail "cannot harden $INETSIM_TEMPLATE_DIR" || return 1
  inetsim_template_clean || fail "$INETSIM_TEMPLATE_DIR still has symlinks, non-root or group/world-writable entries; remove them and re-run" || return 1
}

step_guestfs() {
  ensure_guestfs_appliance "$GUESTFS_DIR" \
    || fail "libguestfs-make-fixed-appliance failed; check libguestfs-test-tool, then re-run" || return 1
}

# ---- browsers ----

BROWSERS_LATER="sudo -u $APP_USER env PLAYWRIGHT_BROWSERS_PATH=$BROWSERS_DIR $MALDEX_OPT/app/Maldex.Web --install-browsers --no-deps"

# Chromium is only for PDF reports. Online it is installed from the Playwright CDN. With --offline it is copied from
# <dir>/ms-playwright when that exists (a PLAYWRIGHT_BROWSERS_PATH tree installed by the same Maldex version); otherwise the step
# warns and the run goes on without it.
step_browsers() {
  app_dir "$BROWSERS_DIR" || fail "cannot create $BROWSERS_DIR" || return 1
  if [ -n "$OFFLINE" ]; then
    local seed="$OFFLINE/ms-playwright"
    if [ -d "$seed" ] && [ ! -L "$seed" ] && compgen -G "$seed/chromium-*" >/dev/null; then
      cp -R "$seed/." "$BROWSERS_DIR/" || fail "cannot copy $seed to $BROWSERS_DIR" || return 1
      chown -R -h "$APP_USER:$APP_USER" "$BROWSERS_DIR" || fail "cannot set the owner of $BROWSERS_DIR" || return 1
      chmod -R u+rwX,g+rX,g-w,o-rwx "$BROWSERS_DIR" || fail "cannot set the mode of $BROWSERS_DIR" || return 1
      return 0
    fi
    echo "warn browsers -- --offline: no Playwright Chromium in $seed, so PDF reports will not work; put a ms-playwright tree there and re-run, or later run: $BROWSERS_LATER" >&2
    return 0
  fi
  sudo -u "$APP_USER" env "PLAYWRIGHT_BROWSERS_PATH=$BROWSERS_DIR" "$MALDEX_OPT/app/Maldex.Web" --install-browsers --no-deps \
    || fail "Playwright Chromium install failed (needs https access to the Playwright CDN); re-run when it is reachable" || return 1
}

# ---- verify ----

ovmf_present() { local f; for f in "${OVMF_SECBOOT_CANDIDATES[@]}"; do [ -f "$f" ] && return 0; done; return 1; }
not_in_sudoers() { ! $MALDEX_SUDO grep -rqs -- "$1" /etc/sudoers /etc/sudoers.d; }
powerless_user() { [ "$(id -nG "$1")" = "$1" ] && [ "$(id -u "$1")" != 0 ] && not_in_sudoers "$1"; }
app_user_groups() { local g; g=" $(id -nG "$APP_USER") "; [[ "$g" == *" kvm "* ]] && [[ "$g" == *" libvirt "* ]]; }
inetsim_ids_distinct() { [ "$(id -u maldex-isroot)" != "$(id -u maldex-isuser)" ] && [ "$(id -g maldex-isroot)" != "$(id -g maldex-isuser)" ]; }
br_netfilter_off() { [ ! -e "$BR_NF_CALL_IPTABLES" ] || [ "$(cat "$BR_NF_CALL_IPTABLES")" != 1 ]; }
mitm_ca_present() { $MALDEX_SUDO test -f "$MITM_CA/mitmproxy-ca.pem" && $MALDEX_SUDO test -f "$MITM_CA/mitmproxy-ca-cert.pem"; }
chromium_present() { compgen -G "$BROWSERS_DIR/chromium-*" >/dev/null; }
agent_present() { [ -f "$AGENT_SRC/Maldex.Agent.exe" ] && [ -f "$AGENT_SRC/Maldex.Agent.version" ]; }
kvm_usable() { maldex_as_user "$APP_USER" test -r "$KVM_DEV" -a -w "$KVM_DEV"; }
guestfs_works() { maldex_as_user "$APP_USER" env LIBGUESTFS_BACKEND=direct "LIBGUESTFS_PATH=$GUESTFS_DIR" libguestfs-test-tool; }

# The real_verify checks for a packaged host: no dev-only ones (pwsh, the docker guacd image, the Docker exception), plus the
# guacd service and the host guard. Sets REAL_FAILED.
verify_checks() {
  local u
  REAL_FAILED=0
  real_check "maldex user in groups kvm and libvirt" "reinstall the maldex package (it creates the user)" app_user_groups
  real_check "/dev/kvm usable by maldex" "enable virtualization in the firmware; load kvm_intel or kvm_amd" kvm_usable
  real_check "libvirt (virsh)" "install libvirt (Ubuntu: libvirt-clients libvirt-daemon; RHEL: libvirt)" virsh --version
  real_check "OVMF secboot firmware" "install OVMF (Ubuntu: ovmf; RHEL: edk2-ovmf)" ovmf_present
  real_check "swtpm" "install swtpm and swtpm-tools" swtpm --version
  real_check "suricata" "install suricata (RHEL: from EPEL)" suricata --build-info
  real_check "mitmdump $MITMPROXY_VERSION" "reinstall the maldex package (it ships mitmproxy)" \
    bash -c "mitmdump --version | grep -q -- '$MITMPROXY_VERSION'"
  real_check "inetsim" "$INETSIM_HINT" inetsim --version
  real_check "yara" "install yara (Ubuntu: universe; RHEL: AppStream); without it analyses run with no YARA detections" yara --version
  real_check "VM emulator $QEMU_EMULATOR" "install qemu-system-x86 (Ubuntu); RHEL: reinstall the maldex package (it links it to /usr/libexec/qemu-kvm from qemu-kvm)" \
    test -x "$QEMU_EMULATOR"
  real_check "wireguard-tools" "install wireguard-tools" wg --version
  real_check "wiminfo" "install wimtools (Ubuntu) / wimlib-utils (RHEL, EPEL)" wiminfo --version
  real_check "xorriso" "install xorriso" xorriso -version
  real_check "xmllint" "install libxml2-utils (Ubuntu) / libxml2 (RHEL)" xmllint --version
  real_check "Sysmon.zip" "maldex-setup (downloads step)" test -f "$ISO_DIR/Sysmon.zip"
  real_check "virtio-win.iso" "maldex-setup (downloads step)" test -f "$ISO_DIR/virtio-win.iso"
  real_check "media library ($MEDIA_DIR)" "maldex-setup (downloads step)" test -d "$MEDIA_DIR"
  real_check "agent bundle ($AGENT_SRC)" "reinstall the maldex package (it ships the agent)" agent_present
  if [ -n "$OFFLINE" ] && ! chromium_present; then
    # Only PDF reports need it; the offline browsers step already warned.
    echo "warn Playwright Chromium ($BROWSERS_DIR) -- missing (--offline); PDF reports will not work until: $BROWSERS_LATER" >&2
  else
    real_check "Playwright Chromium ($BROWSERS_DIR)" "maldex-setup (browsers step)" chromium_present
  fi
  # shellcheck disable=SC2086  # MALDEX_SUDO is empty or "sudo -n"
  real_check "host guard table loaded" "systemctl restart maldex-host-guard" $MALDEX_SUDO nft list table inet maldex_guard
  real_check "host guard enabled at boot" "systemctl enable --now maldex-host-guard" systemctl is-enabled maldex-host-guard
  real_check "guacd active" "systemctl enable --now guacd (RHEL: guacd from EPEL)" systemctl is-active guacd
  real_check "br_netfilter not filtering bridged traffic (host guard assumes this)" "sysctl -w net.bridge.bridge-nf-call-iptables=0 and do not load br_netfilter" \
    br_netfilter_off
  for u in "${SYSTEM_USERS[@]}"; do
    real_check "$u user exists, non-root, own group only, no sudoers" "maldex-setup (mitm-ca step)" powerless_user "$u"
  done
  real_check "INetSim user-namespace ids are distinct" "maldex-setup (mitm-ca step)" inetsim_ids_distinct
  real_check "mitmproxy CA present ($MITM_CA)" "maldex-setup (mitm-ca step)" mitm_ca_present
  real_check "$INETSIM_TEMPLATE_DIR is root-owned, not group/world-writable, symlink-free" "maldex-setup (inetsim step)" inetsim_template_clean
  real_check "guest disk editor (libguestfs appliance)" "maldex-setup (guestfs step); libguestfs-test-tool shows why" guestfs_works
  return "$REAL_FAILED"
}

step_verify() {
  verify_checks || fail "the checks marked FAIL above; fix them and re-run maldex-setup" || return 1
}

# ---- start ----

# restart, not start: a re-run applies changed configuration. The unit is Type=simple, so systemctl returns before the app has
# loaded its configuration or migrated the database; it must still be active a few seconds later.
step_start() {
  local logs="see journalctl -u maldex -n 50 (exit status 78 is a configuration error, named in the log)"
  systemctl enable maldex || fail "systemctl enable maldex failed" || return 1
  systemctl restart maldex || fail "systemctl restart maldex failed; $logs" || return 1
  sleep "$START_WAIT"
  systemctl is-active --quiet maldex || fail "maldex did not stay running; $logs" || return 1
}

# ---- runner ----

run_step() {
  local name="$1" fn="$2"
  HINT=""
  if "$fn"; then
    echo "ok   $name"
  else
    echo "FAIL $name -- ${HINT:-see the output above}" >&2
    exit 1
  fi
}

if [ "$CHECK" = 1 ]; then
  rc=0
  HINT=""
  if db_check; then echo "ok   db"; else echo "FAIL db -- $HINT" >&2; rc=1; fi
  HINT=""
  if admin_check; then echo "ok   admin"; else echo "FAIL admin -- $HINT" >&2; rc=1; fi
  HINT=""
  verify_checks || rc=1
  exit "$rc"
fi

run_step db db_check
run_step admin step_admin
run_step downloads step_downloads
run_step mitm-ca step_mitm_ca
run_step inetsim step_inetsim
run_step guestfs step_guestfs
run_step browsers step_browsers
run_step verify step_verify
run_step start step_start
echo
echo "Maldex is running on $APP_URL (localhost only: put a reverse proxy in front, or use ssh -L 5080:127.0.0.1:5080 <host>)."
echo "Next: sign in at that URL with the admin you created (more users: Admin → Users, or sudo maldex-admin), then build the first"
echo "template under Admin → Sandbox Templates → New template."
