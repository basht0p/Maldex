{
  // Maldex host configuration: /etc/maldex/appsettings.Production.json (root:maldex 0640, kept on upgrade).
  // It is loaded last, after /opt/maldex/app/appsettings.Package.json (MALDEX_EXTRA_CONFIG in maldex.service), so anything set
  // here wins. Comments are allowed. After editing: sudo maldex-setup (first time), or sudo systemctl restart maldex.
  //
  // The package expects Maldex:Mode to stay Real (the packaged defaults set it); do not set Mode here.

  // Required: the external SQL Server database, for example
  // Server=sqlhost,1433;Database=maldex;User Id=maldex;Password=...;TrustServerCertificate=True
  "ConnectionStrings": {
    "Maldex": ""
  },

  // Entra ID sign-in: the app registration of this Maldex instance.
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": ""
  },

  "Maldex": {
    "Real": {
      // Maldex:Real:Root, the data directory (VM images, media, artifacts). The package creates it, owned by maldex, 0750.
      "Root": "/var/lib/maldex",
      // UEFI firmware for the guests: this distro's OVMF Secure Boot code and the variable store with Microsoft keys enrolled.
      "Libvirt": {
        "OvmfCodePath": "/usr/share/OVMF/OVMF_CODE_4M.secboot.fd",
        "OvmfVarsTemplatePath": "/usr/share/OVMF/OVMF_VARS_4M.ms.fd"
      }
    }
  }
}
